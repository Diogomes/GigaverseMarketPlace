# Modelo de configuração de PRODUÇÃO para docker-compose.prod.yml.
# Copie para .env.prod NO SERVIDOR (nunca versionado; chmod 600) ou use o secret manager da hospedagem.
# Todos os valores abaixo são FICTÍCIOS. Referência: docs/ENVIRONMENT_VARIABLES.md e docs/DEPLOYMENT.md.

# --- domínio (D-P08) ---
SITE_ADDRESS=loja.exemplo.com.br
PUBLIC_BASE_URL=https://loja.exemplo.com.br

# --- imagens (tag imutável gerada pelo CI; nunca "latest") ---
IMAGE_REGISTRY=ghcr.io/diogomes
IMAGE_TAG=sha-0000000

# --- banco ---
POSTGRES_DB=gigaverse3d
POSTGRES_USER=gigaverse3d
# gere com: openssl rand -base64 32
POSTGRES_PASSWORD=TROQUE-POR-SENHA-GERADA

# --- e-mail transacional (D-P05) ---
SMTP_HOST=smtp.provedor-exemplo.com
SMTP_PORT=587
SMTP_USERNAME=usuario-do-provedor
SMTP_PASSWORD=TROQUE
APP_MAIL_FROM=Gigaverse3D <nao-responda@exemplo.com.br>
# APP_MAIL_ALLOW_DISABLED=true   # só se decidir conscientemente subir sem e-mail

# --- imagens dos produtos (D-P04): local (volume) ou s3 ---
APP_STORAGE_TYPE=local
# APP_STORAGE_TYPE=s3
# APP_STORAGE_S3_BUCKET=gigaverse3d-media
# APP_STORAGE_S3_REGION=auto
# APP_STORAGE_S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# APP_STORAGE_PUBLIC_BASE_URL=https://media.exemplo.com.br
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- pagamento (D-P01): MANUAL até integrar o gateway ---
APP_PAYMENTS_PROVIDER=MANUAL

# --- primeiro ADMIN: SOMENTE na primeira subida; remova e reinicie depois ---
# APP_BOOTSTRAP_ADMIN_EMAIL=
# APP_BOOTSTRAP_ADMIN_PASSWORD=
# APP_BOOTSTRAP_ADMIN_NAME=
