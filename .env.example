# Copie para .env (que NUNCA é versionado) e ajuste se necessário.
# Valores abaixo são apenas para desenvolvimento local (banco escuta só em 127.0.0.1).
# Referência completa: docs/ENVIRONMENT_VARIABLES.md

# --- docker-compose (PostgreSQL local) ---
POSTGRES_DB=gigaverse3d
POSTGRES_USER=gigaverse3d
POSTGRES_PASSWORD=gigaverse3d_dev
POSTGRES_PORT=5432

# --- backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/gigaverse3d
DB_USERNAME=gigaverse3d
DB_PASSWORD=gigaverse3d_dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
APP_SHIPPING_ORIGIN_POSTAL_CODE=53625816

APP_FRONTEND_BASE_URL=http://localhost:5173
# Primeiro administrador: defina SOMENTE na primeira subida e remova depois (ver docs/LOCAL_SETUP.md).
# APP_BOOTSTRAP_ADMIN_EMAIL=
# APP_BOOTSTRAP_ADMIN_PASSWORD=
# APP_BOOTSTRAP_ADMIN_NAME=

# --- e-mail (dev usa o Mailpit do docker-compose: http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- frontend (Vite) ---
VITE_API_BASE_URL=
