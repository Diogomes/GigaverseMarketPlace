# Simulação LOCAL da pilha de produção (valores fictícios, nada sai da máquina).
# Uso: infra/deploy/simulate.sh
SITE_ADDRESS=loja.gigaverse3d.test
PUBLIC_BASE_URL=https://loja.gigaverse3d.test
HTTP_BIND=127.0.0.1
CADDYFILE=./infra/caddy/Caddyfile.local
IMAGE_REGISTRY=gigaverse3d
IMAGE_TAG=local
POSTGRES_PASSWORD=simulacao-local-nao-e-segredo
# e-mails vão para o Mailpit do perfil "sim" (sem TLS/autenticação)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
APP_MAIL_FROM=Gigaverse3D <nao-responda@gigaverse3d.test>
COMPOSE_PROFILES=sim
